# ============================================================
# IntelliSentiment AI — Environment Variables Example
# Copy this file to .env and fill in actual values
# ============================================================

# Flask Application
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=your-secret-key-here

# Database
DATABASE_URL=sqlite:///database/intellisentiment.db

# Kafka Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_REVIEWS=sentiment-reviews
KAFKA_TOPIC_RESULTS=sentiment-results
KAFKA_GROUP_ID=sentiment-consumer-group

# Airflow Settings
AIRFLOW_HOME=./airflow

# PySpark Settings
SPARK_MASTER=local[*]
SPARK_APP_NAME=IntelliSentimentSpark

# Model Settings
MODEL_DIR=./models
BEST_MODEL_PATH=./models/best_model.joblib
TFIDF_PATH=./models/tfidf_vectorizer.joblib

# Data Settings
RAW_DATA_PATH=./data/raw
PROCESSED_DATA_PATH=./data/processed

# Logging
LOG_LEVEL=INFO

